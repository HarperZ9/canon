# canon environment template. Copy to .env and fill real values there.
# .env is gitignored; this template is the only env file that is committed.
#
# F0 has no runtime secrets. Entries below are placeholders for later phases:
#   R2  renderer target roots (paths are host-local, not secrets)
#   M4  live cross-provider transport (OAuth client credentials go in .env)
#
# CANON_RENDER_ROOT_GLOBAL=
# CANON_RENDER_ROOT_WORKSPACE=
# CANON_OAUTH_CLIENT_ID=
# CANON_OAUTH_CLIENT_SECRET=
